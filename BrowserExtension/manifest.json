{
  "manifest_version": 3,
  "name": "AgentReins Web AI Monitor",
  "version": "0.2.0",
  "description": "Records a local, user-visible evidence trail for supported Web AI sessions.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "https://grok.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": [
      "https://grok.com/*",
      "https://gemini.google.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*"
    ],
    "js": ["web-agent-content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "AgentReins Web AI Monitor"
  }
}
